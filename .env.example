# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# EXPO_PUBLIC_ values are built into the app. That's fine for these: the publishable
# (anon) key only allows what your database's row-level security rules allow.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Accounts (sign-in) are off in v1.0; set to true to work on sign-in and sync.
EXPO_PUBLIC_ACCOUNTS=false

# Set to true once you're in the Apple Developer Program and Apple sign-in is set up in Supabase.
EXPO_PUBLIC_APPLE_SIGN_IN=false
